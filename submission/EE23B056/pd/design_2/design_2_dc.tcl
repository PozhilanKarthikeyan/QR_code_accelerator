# Generated by run_dc.sh -- settings for design_1_p21
set ROOT "/scratch/CS6230_EE23B081/QR_code_accellerator_run2"
set TAG design_1_p21
set PERIOD 2.1
set UNGROUP 0
set COMPILE_FLAGS "-no_autoungroup -no_seq_output_inversion -timing_high_effort_script"
# ---------------------------------------------------------------
# dc_body.tcl  -- shared body for all QR decoder synthesis runs.
# Do not edit per run: run_dc.sh prepends a header that sets
#   ROOT TAG PERIOD UNGROUP COMPILE_FLAGS
# and the combined file is saved as pd/<TAG>/<TAG>_dc.tcl
# ---------------------------------------------------------------
set DESIGN mkQRDecoder
set OUT_DIR  ${ROOT}/pd/${TAG}
set NETLIST  ${ROOT}/syn/outputs/${TAG}
file mkdir $OUT_DIR
file mkdir $NETLIST

# ---------------- Libraries (unchanged from udcounter) ----------------
set PDK_PATH "/home/tools/pdk/SAED14nm_EDK_03_2025"
set SYNOPSYS_ROOT "/home/tools/pd_tools/syn/U-2022.12"

set target_library [list \
  $PDK_PATH/SAED14nm_EDK_STD_RVT/liberty/nldm/base/saed14rvt_base_ss0p72v125c.db ]
set link_library "*"
set link_library [concat $link_library $target_library]
set synthetic_library [list \
  $SYNOPSYS_ROOT/libraries/syn/dw_foundation.sldb \
  $SYNOPSYS_ROOT/libraries/syn/standard.sldb ]
set link_library [concat $link_library $synthetic_library]

set_svf ${NETLIST}/${DESIGN}.svf
set_host_options -max_cores 6

# ---------------- Read RTL ----------------
analyze -format verilog -autoread ${ROOT}/rtl/
elaborate $DESIGN
current_design $DESIGN
link

# ---------------- Constraints (external delay = 40% of period) ----------------
set EXT_DELAY [expr {0.4 * $PERIOD}]
create_clock -name CLK -period $PERIOD -waveform [list 0.0 [expr {$PERIOD / 2.0}]] [get_ports CLK]

set unq_input_list [remove_from_collection [all_inputs] [get_ports CLK]]
set_input_delay  -clock CLK $EXT_DELAY $unq_input_list
set_output_delay -clock CLK $EXT_DELAY [all_outputs]

set_max_area 0
set_dont_retime $DESIGN true

# ---------------- Path groups (same as udcounter) ----------------
group_path -name f2f -from [all_registers]  -to [all_registers] -critical_range 0.15
group_path -name i2f -from $unq_input_list  -to [all_registers] -critical_range 0.15
group_path -name f2o -from [all_registers]  -to [all_outputs]   -critical_range 0.15
group_path -name i2o -from $unq_input_list  -to [all_outputs]   -critical_range 0.15

check_design > ${OUT_DIR}/${TAG}_check_design_pre.rpt

if {$UNGROUP} {
  ungroup -all -flatten
}

# ---------------- Compile ----------------
puts "RUN SETTINGS: TAG=$TAG PERIOD=$PERIOD EXT_DELAY=$EXT_DELAY UNGROUP=$UNGROUP FLAGS=$COMPILE_FLAGS"
eval compile_ultra $COMPILE_FLAGS

define_name_rules verilog -allowed "a-z A-Z 0-9 _ /"
change_names -hier -rules verilog

write -format verilog -hierarchy -output ${NETLIST}/${DESIGN}.verilog.v
write -format ddc     -hierarchy -output ${NETLIST}/${DESIGN}.compile.ddc
write_sdc ${OUT_DIR}/${TAG}_dc.sdc

# ---------------- Reports ----------------
report_qor > ${OUT_DIR}/${TAG}_dc_qor.rpt

set TIMING ${OUT_DIR}/${TAG}_dc_timing.rpt
report_timing -nosplit -max_paths 5 -input -nets -cap -tran -sig 3 -group f2f  > $TIMING
report_timing -nosplit -max_paths 5 -input -nets -cap -tran -sig 3 -group i2f  >> $TIMING
report_timing -nosplit -max_paths 5 -input -nets -cap -tran -sig 3 -group f2o  >> $TIMING
report_timing -nosplit -max_paths 5 -input -nets -cap -tran -sig 3 -group i2o  >> $TIMING

report_power > ${OUT_DIR}/${TAG}_dc_power.rpt
report_area -hierarchy > ${OUT_DIR}/${TAG}_dc_area_hier.rpt
check_design > ${OUT_DIR}/${TAG}_check_design_post.rpt

exit
