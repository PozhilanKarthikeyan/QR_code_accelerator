# Library Setup - SAED14nm EDK 03_2025
# -------------------------------------------------------
set PDK_PATH "/home/tools/pdk/SAED14nm_EDK_03_2025"
/home/tools/pdk/SAED14nm_EDK_03_2025
set target_library    [list]
set link_library      "*"
*
# Define the root path for your 2022 installation
set SYNOPSYS_ROOT "/home/tools/pd_tools/syn/U-2022.12"
/home/tools/pd_tools/syn/U-2022.12
set synthetic_library [list \
  $SYNOPSYS_ROOT/libraries/syn/dw_foundation.sldb \
  $SYNOPSYS_ROOT/libraries/syn/standard.sldb \
]
/home/tools/pd_tools/syn/U-2022.12/libraries/syn/dw_foundation.sldb /home/tools/pd_tools/syn/U-2022.12/libraries/syn/standard.sldb
# Target library: SAED14 RVT, NLDM, base, SS corner (0.72V, 125C) - worst case for setup
set target_library [concat $target_library \
$PDK_PATH/SAED14nm_EDK_STD_RVT/liberty/nldm/base/saed14rvt_base_ss0p72v125c.db \
]
/home/tools/pdk/SAED14nm_EDK_03_2025/SAED14nm_EDK_STD_RVT/liberty/nldm/base/saed14rvt_base_ss0p72v125c.db
# Link library: same RVT base library
set link_library [concat $link_library \
$PDK_PATH/SAED14nm_EDK_STD_RVT/liberty/nldm/base/saed14rvt_base_ss0p72v125c.db \
]
* /home/tools/pdk/SAED14nm_EDK_03_2025/SAED14nm_EDK_STD_RVT/liberty/nldm/base/saed14rvt_base_ss0p72v125c.db
# Combine all libraries
set link_library [concat $link_library $target_library $synthetic_library]
* /home/tools/pdk/SAED14nm_EDK_03_2025/SAED14nm_EDK_STD_RVT/liberty/nldm/base/saed14rvt_base_ss0p72v125c.db /home/tools/pdk/SAED14nm_EDK_03_2025/SAED14nm_EDK_STD_RVT/liberty/nldm/base/saed14rvt_base_ss0p72v125c.db /home/tools/pd_tools/syn/U-2022.12/libraries/syn/dw_foundation.sldb /home/tools/pd_tools/syn/U-2022.12/libraries/syn/standard.sldb
